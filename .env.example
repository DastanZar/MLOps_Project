# AWS Credentials - Required for ECR push and S3 batch predictions
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-2

# ECR Repository - The name of your ECR repository for Docker image storage
ECR_REPOSITORY=mlops-loan-prediction

# S3 Bucket - For storing batch prediction outputs
S3_BUCKET=your-s3-bucket-name

# S3 Folder path prefix for prediction outputs
FOLDER=predictions

# MLflow Tracking Server URI
# For local development: http://localhost:5000
# For docker-compose: http://mlflow:5000
# For AWS EC2 hosted MLflow: http://<ec2-ip>:5000
MLFLOW_TRACKING_URI=http://localhost:5000

# Kubernetes cluster name (for EKS deployment)
EKS_CLUSTER_NAME=mlops
